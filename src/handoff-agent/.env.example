FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.6-luna
DECISION_DEPLOYMENT_NAME=Decision-1
# billing / orders sub-agents: "remote" calls the hosted agents below over the Responses API, "local" runs them in-process
SUBAGENT_MODE=remote
BILLING_AGENT_NAME=billing-agent
ORDERS_AGENT_NAME=orders-agent
# Optional: send x-ms-user-identity on sub-agent calls (needs the UserIdentityImpersonation data action on the
# caller). Off by default; the sub-agents accept calls without an end user (see their caller_scope.py).
SUBAGENT_USER_DELEGATION=false
# Optional: send telemetry to Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
